<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnightblue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:gravity="center"
            android:text="Painel do Diego"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- SEÇÃO: GERENCIAR SERVIÇOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✂️ Gerenciar Serviços e Preços"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#1A252F"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <EditText
                    android:id="@+id/editServiceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome do Serviço (ex: Corte e Barba)"
                    android:textColor="@color/white"
                    android:textColorHint="#95A5A6"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/editServicePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Valor (ex: R$ 45,00)"
                    android:textColor="@color/white"
                    android:textColorHint="#95A5A6"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="15dp"/>

                <Button
                    android:id="@+id/btnAddService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SALVAR SERVIÇO"
                    android:backgroundTint="#1ABC9C"
                    android:textStyle="bold"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServicesManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="30dp"
            tools:listitem="@layout/service_management_item"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2C3E50"
            android:layout_marginBottom="30dp"/>

        <!-- SEÇÃO: PORTFÓLIO (EXISTENTE) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Gerenciar Portfólio (Fotos)"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#1A252F"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_launcher_background"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnSelectImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escolher Foto"
                    android:backgroundTint="#3498DB"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/editDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descrição da Foto"
                    android:textColor="@color/white"
                    android:textColorHint="#95A5A6"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="15dp"/>

                <Button
                    android:id="@+id/btnUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PUBLICAR NO PORTFÓLIO"
                    android:backgroundTint="#1ABC9C"
                    android:textStyle="bold"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/management_item"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
